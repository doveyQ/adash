# --- DASHBOARD CONNECTION ---
# Use 'localhost' if running on the same machine, or the Server IP
API_URL=http://localhost:3000
API_KEY=must_match_dashboard_api_key

# --- BIOMETRICS (INTERVALS.ICU) ---
# Find these in Intervals.icu > Settings
INTERVALS_API_KEY=your_intervals_api_key_here
INTERVALS_ATHLETE_ID=i00000

# --- GITHUB ---
# Personal Access Token (PAT) with 'repo' and 'read:user' scopes
GITHUB_TOKEN=your_github_pat_here
# Optional: comma-separated list of repos (e.g. "user/repo1,user/repo2")
# If empty, all accessible repos will be discovered automatically.
GITHUB_REPOS=
GITHUB_USERNAME=your_github_username
GITHUB_POLL_INTERVAL=900